# Server-side only — NOT exposed to the browser (no NEXT_PUBLIC_ prefix)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id

# Redirect URI used by both server config and MSAL browser flow
# Server-side (used to construct the MSAL config response)
AZURE_REDIRECT_URI=http://localhost:3000

# Client-side safe — only the redirect URI is needed in the browser
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
